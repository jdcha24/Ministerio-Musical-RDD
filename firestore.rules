rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLeaderOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'leader' || 
        getUserData().role == 'admin' ||
        request.auth.token.role in ['leader', 'admin']
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    // Colección de Usuarios
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Catálogo de Canciones
    match /songs/{songId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isLeaderOrAdmin();
    }

    // Servicios / Planificación
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow create, delete: if isLeaderOrAdmin();
      allow update: if isLeaderOrAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team'])
      );
    }
  }
}
